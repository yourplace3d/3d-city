{
  "name": "your-place-data",
  "private": true,
  "version": "0.9.0",
  "description": "Your Place · Data — open data about a city on a 3D model of any place: steepness, traffic, public transport, rents and incomes, your own route.",
  "homepage": "https://yourplace3d.github.io/3d-city/",
  "repository": {
    "type": "git",
    "url": "https://github.com/yourplace3d/3d-city.git"
  },
  "bugs": "https://github.com/yourplace3d/3d-city/issues",
  "keywords": [
    "3d-map",
    "city-model",
    "terrain",
    "openstreetmap",
    "stl",
    "3d-printing",
    "three.js"
  ],
  "license": "MIT",
  "type": "module",
  "scripts": {
    "dev": "vite",
    "build": "tsc --noEmit && vite build",
    "preview": "vite preview",
    "typecheck": "tsc --noEmit",
    "test": "vitest run",
    "e2e": "npm run build && node e2e/smoke.mjs"
  },
  "dependencies": {
    "@mapbox/vector-tile": "2.0.3",
    "earcut": "3.2.4",
    "pbf": "4.0.1",
    "polygon-clipping": "0.15.7",
    "three": "0.187.0"
  },
  "devDependencies": {
    "@types/three": "0.187.0",
    "geojson-vt": "4.0.2",
    "typescript": "5.9.3",
    "vite": "8.3.5",
    "vitest": "5.1.0",
    "vt-pbf": "3.1.3"
  }
}
